{
  "$defs": {
    "Mode": {
      "enum": [
        "t2v",
        "i2v",
        "v2v"
      ],
      "title": "Mode",
      "type": "string"
    }
  },
  "properties": {
    "mode": {
      "$ref": "#/$defs/Mode",
      "description": "The mode of the pipeline"
    },
    "prompt": {
      "description": "The prompt for the pipeline. Used for all modes.",
      "title": "Prompt",
      "type": "string"
    },
    "image": {
      "anyOf": [
        {
          "format": "file",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "For i2v mode, the source image path",
      "title": "Image"
    },
    "prefix_video": {
      "anyOf": [
        {
          "format": "file",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "For v2v mode, the source video path",
      "title": "Prefix Video"
    },
    "seed": {
      "default": -1,
      "description": "Random seed. -1 means random.",
      "title": "Seed",
      "type": "integer"
    },
    "num_frames": {
      "default": 96,
      "description": "Number of frames in the output video.",
      "title": "Num Frames",
      "type": "integer"
    },
    "num_steps": {
      "default": 8,
      "description": "Number of inference steps.",
      "title": "Num Steps",
      "type": "integer"
    },
    "window_size": {
      "default": 4,
      "description": "Window size for inference.",
      "title": "Window Size",
      "type": "integer"
    },
    "fps": {
      "default": 24,
      "description": "Frames per second.",
      "title": "Fps",
      "type": "integer"
    },
    "chunk_width": {
      "default": 6,
      "description": "Chunk width for inference.",
      "title": "Chunk Width",
      "type": "integer"
    },
    "width": {
      "default": 1280,
      "description": "Width of the output video. Must be multiple of 8.",
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "default": 720,
      "description": "Height of the output video. Must be multiple of 8.",
      "title": "Height",
      "type": "integer"
    }
  },
  "required": [
    "mode",
    "prompt"
  ],
  "title": "AppInput",
  "type": "object"
}