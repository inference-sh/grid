{
  "$defs": {
    "File": {
      "$id": "/schemas/File",
      "oneOf": [
        {
          "description": "A class representing a file in the inference.sh ecosystem.",
          "properties": {
            "uri": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Uri"
            },
            "path": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Path"
            },
            "content_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Content Type"
            },
            "size": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Size"
            },
            "filename": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Filename"
            }
          },
          "title": "File",
          "type": "object"
        },
        {
          "type": "string"
        }
      ]
    }
  },
  "properties": {
    "video": {
      "$ref": "#/$defs/File",
      "description": "Input video file to be processed and transformed"
    },
    "prompt": {
      "description": "Text prompt describing the desired video transformation",
      "title": "Prompt",
      "type": "string"
    },
    "reference_images": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/File"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional list of reference images",
      "title": "Reference Images"
    },
    "negative_prompt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Negative prompt to avoid unwanted content",
      "title": "Negative Prompt"
    },
    "num_inference_steps": {
      "default": 8,
      "description": "Number of inference steps (6-10 recommended)",
      "maximum": 10,
      "minimum": 6,
      "title": "Num Inference Steps",
      "type": "integer"
    },
    "boundary_ratio": {
      "default": 0.875,
      "description": "Boundary ratio between high and low noise transformers (0-1)",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Boundary Ratio",
      "type": "number"
    },
    "seed": {
      "default": 42,
      "description": "Random seed for reproducible results",
      "title": "Seed",
      "type": "integer"
    }
  },
  "required": [
    "video",
    "prompt"
  ],
  "title": "AppInput",
  "type": "object"
}