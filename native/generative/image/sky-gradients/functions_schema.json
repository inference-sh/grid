        "aurora_color_variation": {
          "default": 0.7,
          "description": "Aurora colour variation.",
          "maximum": 1.5,
          "minimum": 0,
          "title": "Aurora Color Variation",
          "type": "number"
        },
        "aurora_upper_color": {
          "default": 0.3,
          "description": "Aurora upper colour.",
