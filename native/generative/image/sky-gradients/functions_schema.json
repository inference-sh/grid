  "render_video": {
    "description": "Render an animated sky gradient as an MP4: the sun cycles or sweeps while aurora, leaks and grain move.",
    "kind": "run",
    "capabilities": [],
    "input_schema": {
      "properties": {
        "duration": {
          "default": 8,
          "description": "Video length in seconds.",
          "maximum": 60,
          "minimum": 1,
          "title": "Duration",
          "type": "number"
        },
        "fps": {
          "default": 30,
          "description": "Frames per second.",
          "maximum": 60,
          "minimum": 1,
          "title": "Fps",
          "type": "integer"
        },
        "sun_motion": {
          "default": "cycle",
          "description": "cycle: sun eases down into twilight and back up, looping. sweep: sun moves once from sun_elevation to sun_end. still: sun fixed; only aurora, leak and grain move.",
          "enum": [
            "cycle",
            "sweep",
            "still"
          ],
          "title": "Sun Motion",
          "type": "string"
        },
        "sun_cycles": {
          "default": 1,
          "description": "Full sun loops per video (cycle).",
          "maximum": 8,
          "minimum": 1,
          "title": "Sun Cycles",
          "type": "integer"
        },
        "sun_end": {
          "anyOf": [
            {
              "maximum": 0.5,
              "minimum": -9.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Final sun elevation for sweep (default: the far end of the window).",
          "title": "Sun End"
        },
        "seamless_loop": {
          "default": true,
          "description": "Fade the end of aurora and leak motion into the start so the video loops without a jump (cycle and still).",
          "title": "Seamless Loop",
          "type": "boolean"
        },
        "animate_grain": {
          "default": false,
          "description": "New grain every frame, like film. Noise does not compress: files get about 10x larger; raise crf to compensate.",
          "title": "Animate Grain",
          "type": "boolean"
        },
        "crf": {
          "default": 18,
          "description": "H.264 quality; lower is better and larger.",
          "maximum": 40,
          "minimum": 0,
          "title": "Crf",
          "type": "integer"
        },
        "width": {
          "default": 1920,
          "description": "Output width in pixels. Odd sizes are rounded up to even for H.264.",
          "maximum": 8192,
          "minimum": 2,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 1080,
          "description": "Output height in pixels. Odd sizes are rounded up to even for H.264.",
          "maximum": 8192,
          "minimum": 2,
          "title": "Height",
          "type": "integer"
        },
        "randomize": {
          "default": "new",
          "description": "new: a fresh random sky. nearby: small changes around the given settings or recipe. off: exactly the given settings. When randomizing, settings left at their default are randomized and changed ones are kept.",
          "enum": [
            "new",
            "nearby",
            "off"
          ],
          "title": "Randomize",
          "type": "string"
        },
        "random_seed": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seed for randomize; the same seed and settings give the same sky.",
          "title": "Random Seed"
        },
        "spice": {
          "default": true,
          "description": "When randomizing, sometimes add aurora and light leaks.",
          "title": "Spice",
          "type": "boolean"
        },
        "recipe": {
          "anyOf": [
