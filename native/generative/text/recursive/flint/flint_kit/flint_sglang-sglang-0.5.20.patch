+class _ResolvedServerArgs:
+    """SGLang 0.5.20 retired get_global_server_args(). Each field reads the resolved value by name:
+    fields of the parallel namespace from get_parallel(), the rest from their config bag."""
+
+    def __getattr__(self, name):
+        if namespace_of(ServerArgs).get(name, "").split(".")[0] == "parallel":
+            return getattr(get_parallel(), name)
+        return get_context().config_leaf(name)
+
+
+def get_global_server_args() -> _ResolvedServerArgs:
