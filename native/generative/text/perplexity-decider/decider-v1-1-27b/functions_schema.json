{
  "run": {
    "description": "Evaluate the state and images against every question.",
    "kind": "run",
    "capabilities": [],
    "input_schema": {
      "$defs": {
        "ChoiceOption": {
          "properties": {
            "name": {
              "description": "Option name. Returned as `choice` and used as the key in `probabilities`. Sent to the model.",
              "minLength": 1,
              "title": "Name",
              "type": "string"
            },
            "description": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "items": {},
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "What this option covers. Omit when the name is clear on its own.",
              "title": "Description"
            }
          },
          "required": [
            "name"
          ],
          "title": "ChoiceOption",
          "type": "object"
        },
        "ChoiceQuestion": {
          "description": "Which of these options? For a fixed set of unordered options.",
          "properties": {
            "id": {
              "description": "Your key for this question; the answer comes back under it. Not sent to the model.",
              "minLength": 1,
              "title": "Id",
              "type": "string"
            },
            "instructions": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "items": {},
                  "type": "array"
                }
              ],
              "description": "What the model should decide, written as a complete question.",
              "title": "Instructions"
            },
            "options": {
              "description": "The answer options (2 to 255). Give the full list, and add an `other` option when the list might not cover every input.",
              "items": {
                "$ref": "#/$defs/ChoiceOption"
              },
              "maxItems": 255,
              "minItems": 2,
              "title": "Options",
              "type": "array"
            }
          },
          "required": [
            "id",
            "instructions",
            "options"
          ],
          "title": "ChoiceQuestion",
          "type": "object"
        },
        "NoulCriteria": {
          "properties": {
            "true": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "items": {},
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "What a yes (value near 1) means.",
              "title": "True"
            },
            "false": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "items": {},
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "What a no (value near 0) means.",
              "title": "False"
            }
          },
          "title": "NoulCriteria",
          "type": "object"
        },
        "NoulQuestion": {
          "description": "Is this true? For a clean yes/no where the probability itself is the signal.",
          "properties": {
            "id": {
              "description": "Your key for this question; the answer comes back under it. Not sent to the model.",
              "minLength": 1,
              "title": "Id",
              "type": "string"
            },
            "instructions": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "items": {},
                  "type": "array"
                }
              ],
              "description": "The yes/no question, or a statement to judge. Make the boundary between yes and no unambiguous.",
              "title": "Instructions"
            },
            "criteria": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NoulCriteria"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Optional. Pins down a subtle yes/no boundary."
            }
          },
          "required": [
            "id",
            "instructions"
          ],
          "title": "NoulQuestion",
          "type": "object"
        },
        "ScoreQuestion": {
          "description": "Which level? For a position on a spectrum you can describe.",
          "properties": {
            "id": {
              "description": "Your key for this question; the answer comes back under it. Not sent to the model.",
              "minLength": 1,
              "title": "Id",
              "type": "string"
            },
            "instructions": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "items": {},
                  "type": "array"
                }
              ],
              "description": "What the model should rate, written as a complete question.",
              "title": "Instructions"
            },
            "levels": {
              "description": "Ordered level descriptions, low end to high end (2 to 10). A level's number is its index, starting at 0.",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "items": {},
                    "type": "array"
                  }
                ]
              },
              "maxItems": 10,
              "minItems": 2,
              "title": "Levels",
              "type": "array"
            }
          },
          "required": [
            "id",
            "instructions",
            "levels"
          ],
          "title": "ScoreQuestion",
          "type": "object"
        }
      },
      "properties": {
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "items": {},
              "type": "array"
            }
          ],
          "default": "",
          "description": "The text to evaluate: a string, or a JSON object / array of related context (messages, records, a policy). Every question sees the same state and images. May be empty when `images` carries the content. Input over the model's token limit is rejected, never truncated.",
          "examples": [
            "Seller title: wireless earbuds, barely used"
          ],
          "title": "State"
        },
        "images": {
          "description": "Up to 4 images the questions are about (PNG, JPEG or WebP). Every question sees them, placed before the state.",
          "items": {
            "format": "file",
            "type": "string"
          },
          "maxItems": 4,
          "title": "Images",
          "type": "array"
        },
        "choices": {
          "description": "Choice questions: pick one option from a set.",
          "items": {
            "$ref": "#/$defs/ChoiceQuestion"
          },
          "title": "Choices",
          "type": "array"
        },
        "scores": {
          "description": "Score questions: place the state on ordered levels.",
          "items": {
            "$ref": "#/$defs/ScoreQuestion"
          },
          "title": "Scores",
          "type": "array"
        },
        "nouls": {
          "description": "Noul questions: probability that the answer is yes.",
          "items": {
            "$ref": "#/$defs/NoulQuestion"
          },
          "title": "Nouls",
          "type": "array"
        }
      },
      "title": "AppInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AudioMeta": {
          "description": "Metadata for audio inputs/outputs.",
          "properties": {
            "type": {
              "default": "audio",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "seconds": {
              "default": 0,
              "description": "Duration in seconds",
              "title": "Seconds",
              "type": "number"
            },
            "sample_rate": {
              "default": 0,
              "description": "Sample rate in Hz",
              "title": "Sample Rate",
              "type": "integer"
            }
          },
          "title": "AudioMeta",
          "type": "object"
        },
        "ChoiceAnswer": {
          "properties": {
            "choice": {
              "description": "The highest-probability option.",
              "title": "Choice",
              "type": "string"
            },
            "confidence": {
              "description": "0 to 1: how sure the model is of `choice`. Gate actions on it; thresholds scale with risk.",
              "title": "Confidence",
              "type": "number"
            },
            "probabilities": {
              "additionalProperties": {
                "type": "number"
              },
              "description": "Every option mapped to its probability.",
              "title": "Probabilities",
              "type": "object"
            }
          },
          "required": [
            "choice",
            "confidence",
            "probabilities"
          ],
          "title": "ChoiceAnswer",
          "type": "object"
        },
        "ImageMeta": {
          "description": "Metadata for image inputs/outputs.",
          "properties": {
            "type": {
              "default": "image",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "width": {
              "default": 0,
              "description": "Image width in pixels",
              "title": "Width",
              "type": "integer"
            },
            "height": {
              "default": 0,
              "description": "Image height in pixels",
              "title": "Height",
              "type": "integer"
            },
            "resolution_mp": {
              "default": 0,
              "description": "Resolution in megapixels (width * height / 1_000_000)",
              "title": "Resolution Mp",
              "type": "number"
            },
            "steps": {
              "default": 0,
              "description": "Number of diffusion steps",
              "title": "Steps",
              "type": "integer"
            },
            "count": {
              "default": 1,
              "description": "Number of images",
              "title": "Count",
              "type": "integer"
            }
          },
          "title": "ImageMeta",
          "type": "object"
        },
        "NoulAnswer": {
          "properties": {
            "noul": {
              "description": "Probability the answer is yes. Near 1 strong yes, near 0 strong no, near 0.5 uncertain. Threshold it in code.",
              "title": "Noul",
              "type": "number"
            }
          },
          "required": [
            "noul"
          ],
          "title": "NoulAnswer",
          "type": "object"
        },
        "OutputMeta": {
          "description": "Structured metadata about task inputs and outputs for pricing calculation.\n\nApps include this in their output to report what was consumed (inputs)\nand what was produced (outputs). The backend uses this with CEL expressions\nto calculate app-level pricing.\n\nExample usage in an LLM app:\n    output_meta = OutputMeta(\n        inputs=[TextMeta(tokens=150)],\n        outputs=[TextMeta(tokens=500)]\n    )\n\nExample usage in a video generation app:\n    output_meta = OutputMeta(\n        outputs=[VideoMeta(\n            resolution=\"1080p\",\n            resolution_mp=2.07,\n            seconds=10.5,\n            fps=30\n        )]\n    )",
          "properties": {
            "inputs": {
              "description": "Metadata about consumed inputs",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TextMeta"
                  },
                  {
                    "$ref": "#/$defs/ImageMeta"
                  },
                  {
                    "$ref": "#/$defs/VideoMeta"
                  },
                  {
                    "$ref": "#/$defs/AudioMeta"
                  },
                  {
                    "$ref": "#/$defs/RawMeta"
                  }
                ]
              },
              "title": "Inputs",
              "type": "array"
            },
            "outputs": {
              "description": "Metadata about produced outputs",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TextMeta"
                  },
                  {
                    "$ref": "#/$defs/ImageMeta"
                  },
                  {
                    "$ref": "#/$defs/VideoMeta"
                  },
                  {
                    "$ref": "#/$defs/AudioMeta"
                  },
                  {
                    "$ref": "#/$defs/RawMeta"
                  }
                ]
              },
              "title": "Outputs",
              "type": "array"
            }
          },
          "title": "OutputMeta",
          "type": "object"
        },
        "RawMeta": {
          "description": "Metadata for raw inputs/outputs used for custom pricing.",
          "properties": {
            "type": {
              "default": "raw",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "cost": {
              "default": 0,
              "description": "Cost in dollar cents",
              "title": "Cost",
              "type": "number"
            }
          },
          "title": "RawMeta",
          "type": "object"
        },
        "ScoreAnswer": {
          "properties": {
            "score": {
              "description": "Probability-weighted position on the levels, 0 to the top level number. Can land between levels.",
              "title": "Score",
              "type": "number"
            },
            "normalized": {
              "description": "`score` divided by the top level number: 0 to 1, comparable across scales of different length.",
              "title": "Normalized",
              "type": "number"
            },
            "confidence": {
              "description": "0 to 1: how sure the model is of the most likely level.",
              "title": "Confidence",
              "type": "number"
            },
            "probabilities": {
              "additionalProperties": {
                "type": "number"
              },
              "description": "Each level number (as a string) mapped to its probability.",
              "title": "Probabilities",
              "type": "object"
            },
            "legend": {
              "additionalProperties": true,
              "description": "Each level number mapped back to its description.",
              "title": "Legend",
              "type": "object"
            }
          },
          "required": [
            "score",
            "normalized",
            "confidence",
            "probabilities",
            "legend"
          ],
          "title": "ScoreAnswer",
          "type": "object"
        },
        "TextMeta": {
          "description": "Metadata for text inputs/outputs (e.g., LLM tokens).",
          "properties": {
            "type": {
              "default": "text",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "tokens": {
              "default": 0,
              "description": "Token count - in inputs[] = input tokens, in outputs[] = output tokens",
              "title": "Tokens",
              "type": "integer"
            }
          },
          "title": "TextMeta",
          "type": "object"
        },
        "VideoMeta": {
          "description": "Metadata for video inputs/outputs.",
          "properties": {
            "type": {
              "default": "video",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "width": {
              "default": 0,
              "description": "Video width in pixels",
              "title": "Width",
              "type": "integer"
            },
            "height": {
              "default": 0,
              "description": "Video height in pixels",
              "title": "Height",
              "type": "integer"
            },
            "resolution_mp": {
              "default": 0,
              "description": "Resolution in megapixels per frame",
              "title": "Resolution Mp",
              "type": "number"
            },
            "resolution": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Standard resolution preset (480p, 720p, 1080p, 1440p, 4k)",
              "title": "Resolution"
            },
            "seconds": {
              "default": 0,
              "description": "Duration in seconds",
              "title": "Seconds",
              "type": "number"
            },
            "fps": {
              "default": 0,
              "description": "Frames per second",
              "title": "Fps",
              "type": "integer"
            }
          },
          "title": "VideoMeta",
          "type": "object"
        }
      },
      "properties": {
        "model": {
          "description": "The model that answered: `perplexity-ai/pplx-decider-v1.1-27b`.",
          "title": "Model",
          "type": "string"
        },
        "input_tokens": {
          "default": 0,
          "description": "Input tokens, summed over the questions. Image tokens are included.",
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_meta": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputMeta"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured metadata about inputs/outputs for pricing calculation"
        },
        "choices": {
          "additionalProperties": {
            "$ref": "#/$defs/ChoiceAnswer"
          },
          "description": "Choice answers by question id.",
          "title": "Choices",
          "type": "object"
        },
        "scores": {
          "additionalProperties": {
            "$ref": "#/$defs/ScoreAnswer"
          },
          "description": "Score answers by question id.",
          "title": "Scores",
          "type": "object"
        },
        "nouls": {
          "additionalProperties": {
            "$ref": "#/$defs/NoulAnswer"
          },
          "description": "Noul answers by question id.",
          "title": "Nouls",
          "type": "object"
        }
      },
      "required": [
        "model"
      ],
      "title": "AppOutput",
      "type": "object"
    }
  }
}