{
  "properties": {
    "html_content": {
      "description": "The HTML string to render",
      "title": "Html Content",
      "type": "string"
    },
    "width": {
      "default": 800,
      "description": "Viewport width in pixels",
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "default": 600,
      "description": "Viewport height in pixels",
      "title": "Height",
      "type": "integer"
    },
    "output_format": {
      "default": "png",
      "description": "Output image format (jpeg or png)",
      "enum": [
        "jpeg",
        "png"
      ],
      "title": "Output Format",
      "type": "string"
    },
    "full_page": {
      "default": true,
      "description": "Capture the whole scrollable page; false captures only the width x height viewport",
      "title": "Full Page",
      "type": "boolean"
    },
    "quality": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "JPEG quality (1-100); ignored for png",
      "title": "Quality"
    },
    "wait_until": {
      "default": "load",
      "description": "When to capture: after the load event and web fonts, or after the network has also been idle for 500 ms (for pages that fetch content after load)",
      "enum": [
        "load",
        "networkidle"
      ],
      "title": "Wait Until",
      "type": "string"
    }
  },
  "required": [
    "html_content"
  ],
  "title": "AppInput",
  "type": "object"
}