{
  "run": {
    "description": "Perform a script as speech, directed by the tags in the text.",
    "kind": "run",
    "capabilities": [],
    "annotations": {
      "title": "Text to speech",
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    },
    "input_schema": {
      "properties": {
        "text": {
          "description": "What to say, and how. Bracketed directions and sounds are performed, not read: [barely holding it together] I'm fine. [small laugh] Paired tags shape specific words: <whisper>, <emphasis>, <soft>, <fast>, <slow>, <stress>, <forceful>. For dialogue, mark turns with <|speaker:0|>, <|speaker:1|>, ... matching the order of voice_ids.",
          "maxLength": 30000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "voice_ids": {
          "description": "Fish Audio voice ids (from fish.audio). One id for a single voice; several for a dialogue, one per speaker tag in order. Empty: the model picks a voice.",
          "examples": [
            [
              "bf322df2096a46f18c579d0baa36f41d"
            ]
          ],
          "items": {
            "type": "string"
          },
          "title": "Voice Ids",
          "type": "array"
        },
        "reference_audio": {
          "anyOf": [
            {
              "format": "file",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A clip of the voice to clone: 10 to 30 seconds of clear speech, WAV, MP3 or FLAC. Use it instead of voice_ids.",
          "title": "Reference Audio"
        },
        "reference_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact transcript of reference_audio. Required with it.",
          "title": "Reference Text"
        },
        "format": {
          "default": "mp3",
          "description": "Audio format. pcm is raw 16-bit mono.",
          "enum": [
            "mp3",
            "wav",
            "opus",
            "pcm"
          ],
          "title": "Format",
          "type": "string"
        },
        "sample_rate": {
          "anyOf": [
            {
              "enum": [
                8000,
                16000,
                24000,
                32000,
                44100,
                48000
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sample rate in Hz. Empty: 44100, or 48000 for opus. mp3 takes 32000 or 44100; opus only 48000.",
          "title": "Sample Rate"
        },
        "speed": {
          "default": 1.0,
          "description": "Speaking speed, 0.5 to 2.",
          "maximum": 2.0,
          "minimum": 0.5,
          "title": "Speed",
          "type": "number"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sampling temperature, 0 to 1. Higher is more varied. Empty: Fish Audio's default.",
          "title": "Temperature"
        },
        "top_p": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nucleus sampling, 0 to 1. Empty: Fish Audio's default.",
          "title": "Top P"
        },
        "normalize": {
          "default": true,
          "description": "Normalize numbers and symbols in English and Chinese text before speaking.",
          "title": "Normalize",
          "type": "boolean"
        },
        "latency": {
          "default": "normal",
          "description": "normal for best quality; balanced and low trade quality for a faster start.",
          "enum": [
            "normal",
            "balanced",
            "low"
          ],
          "title": "Latency",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "AppInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AudioMeta": {
          "description": "Metadata for audio inputs/outputs.",
          "properties": {
            "type": {
              "default": "audio",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "seconds": {
              "default": 0,
              "description": "Duration in seconds",
              "title": "Seconds",
              "type": "number"
            },
            "sample_rate": {
              "default": 0,
              "description": "Sample rate in Hz",
              "title": "Sample Rate",
              "type": "integer"
            }
          },
          "title": "AudioMeta",
          "type": "object"
        },
        "ImageMeta": {
          "description": "Metadata for image inputs/outputs.",
          "properties": {
            "type": {
              "default": "image",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "width": {
              "default": 0,
              "description": "Image width in pixels",
              "title": "Width",
              "type": "integer"
            },
            "height": {
              "default": 0,
              "description": "Image height in pixels",
              "title": "Height",
              "type": "integer"
            },
            "resolution_mp": {
              "default": 0,
              "description": "Resolution in megapixels (width * height / 1_000_000)",
              "title": "Resolution Mp",
              "type": "number"
            },
            "steps": {
              "default": 0,
              "description": "Number of diffusion steps",
              "title": "Steps",
              "type": "integer"
            },
            "count": {
              "default": 1,
              "description": "Number of images",
              "title": "Count",
              "type": "integer"
            }
          },
          "title": "ImageMeta",
          "type": "object"
        },
        "OutputMeta": {
          "description": "Structured metadata about task inputs and outputs for pricing calculation.\n\nApps include this in their output to report what was consumed (inputs)\nand what was produced (outputs). The backend uses this with CEL expressions\nto calculate app-level pricing.\n\nExample usage in an LLM app (or OutputMeta.from_llm_usage(usage)):\n    output_meta = OutputMeta(\n        inputs=[TextMeta(tokens=150, cached_tokens=100)],\n        outputs=[TextMeta(tokens=500)]\n    )\n\nExample usage in a video generation app:\n    output_meta = OutputMeta(\n        outputs=[VideoMeta(\n            resolution=\"1080p\",\n            resolution_mp=2.07,\n            seconds=10.5,\n            fps=30\n        )]\n    )",
          "properties": {
            "inputs": {
              "description": "Metadata about consumed inputs",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TextMeta"
                  },
                  {
                    "$ref": "#/$defs/ImageMeta"
                  },
                  {
                    "$ref": "#/$defs/VideoMeta"
                  },
                  {
                    "$ref": "#/$defs/AudioMeta"
                  },
                  {
                    "$ref": "#/$defs/RawMeta"
                  }
                ]
              },
              "title": "Inputs",
              "type": "array"
            },
            "outputs": {
              "description": "Metadata about produced outputs",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TextMeta"
                  },
                  {
                    "$ref": "#/$defs/ImageMeta"
                  },
                  {
                    "$ref": "#/$defs/VideoMeta"
                  },
                  {
                    "$ref": "#/$defs/AudioMeta"
                  },
                  {
                    "$ref": "#/$defs/RawMeta"
                  }
                ]
              },
              "title": "Outputs",
              "type": "array"
            }
          },
          "title": "OutputMeta",
          "type": "object"
        },
        "RawMeta": {
          "description": "Metadata for raw inputs/outputs used for custom pricing.",
          "properties": {
            "type": {
              "default": "raw",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "cost": {
              "default": 0,
              "description": "Cost in dollar cents",
              "title": "Cost",
              "type": "number"
            }
          },
          "title": "RawMeta",
          "type": "object"
        },
        "TextMeta": {
          "description": "Metadata for text inputs/outputs (e.g., LLM tokens).",
          "properties": {
            "type": {
              "default": "text",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "tokens": {
              "default": 0,
              "description": "Token count - in inputs[] = input tokens (cached ones included), in outputs[] = output tokens",
              "title": "Tokens",
              "type": "integer"
            },
            "cached_tokens": {
              "default": 0,
              "description": "Input tokens read from the provider's prompt cache, part of tokens",
              "title": "Cached Tokens",
              "type": "integer"
            },
            "cache_write_tokens": {
              "default": 0,
              "description": "Input tokens written to the provider's prompt cache, part of tokens",
              "title": "Cache Write Tokens",
              "type": "integer"
            }
          },
          "title": "TextMeta",
          "type": "object"
        },
        "VideoMeta": {
          "description": "Metadata for video inputs/outputs.",
          "properties": {
            "type": {
              "default": "video",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "width": {
              "default": 0,
              "description": "Video width in pixels",
              "title": "Width",
              "type": "integer"
            },
            "height": {
              "default": 0,
              "description": "Video height in pixels",
              "title": "Height",
              "type": "integer"
            },
            "resolution_mp": {
              "default": 0,
              "description": "Resolution in megapixels per frame",
              "title": "Resolution Mp",
              "type": "number"
            },
            "resolution": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Standard resolution preset (480p, 720p, 1080p, 1440p, 4k)",
              "title": "Resolution"
            },
            "seconds": {
              "default": 0,
              "description": "Duration in seconds",
              "title": "Seconds",
              "type": "number"
            },
            "fps": {
              "default": 0,
              "description": "Frames per second",
              "title": "Fps",
              "type": "integer"
            }
          },
          "title": "VideoMeta",
          "type": "object"
        }
      },
      "properties": {
        "audio": {
          "description": "The generated speech.",
          "format": "file",
          "title": "Audio",
          "type": "string"
        },
        "output_meta": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputMeta"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured metadata about inputs/outputs for pricing calculation"
        }
      },
      "required": [
        "audio"
      ],
      "title": "AppOutput",
      "type": "object"
    }
  }
}