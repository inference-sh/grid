            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "keyterms": {
          "description": "Product names, acronyms and other literal terms that may be said. Each on one line, without < or >.",
          "items": {
            "type": "string"
          },
          "title": "Keyterms",
          "type": "array"
        }
      },
      "required": [
        "audio"
      ],
      "title": "AppInput",
      "type": "object"
    },
