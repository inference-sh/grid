        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        }
      },
      "required": [
        "role"
      ],
      "title": "ContextMessage",
      "type": "object"
    },
    "ReasoningEffortEnum": {
      "enum": [
        "low",
