    "ChatMessageRole": {
      "enum": [
        "system",
        "user",
        "assistant",
        "tool",
        "injection",
        "compaction"
      ],
      "title": "ChatMessageRole",
      "type": "string"
    },
    "ContextMessage": {
      "properties": {
        "role": {
          "$ref": "#/$defs/ChatMessageRole"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
