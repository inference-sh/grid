  "run_report": {
    "description": "Run a GA4 report: metrics such as users, sessions and conversions, grouped by dimensions such as date, page or source.",
    "kind": "run",
    "capabilities": [],
    "credentials": [
      {
        "slug": "google",
        "capabilities": [
          "google.analytics.readonly"
        ]
      }
    ],
    "annotations": {
      "title": "Run report",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "input_schema": {
      "$defs": {
        "DateRange": {
          "properties": {
            "start_date": {
              "description": "YYYY-MM-DD, or relative: today, yesterday, 7daysAgo, 28daysAgo",
              "title": "Start Date",
              "type": "string"
            },
            "end_date": {
              "description": "YYYY-MM-DD, or relative: today, yesterday",
              "title": "End Date",
              "type": "string"
            }
          },
          "required": [
            "start_date",
            "end_date"
          ],
          "title": "DateRange",
          "type": "object"
        }
      },
      "properties": {
        "property_id": {
          "description": "Property ID from list_properties, e.g. 123456789",
          "title": "Property Id",
          "type": "string"
        },
        "metrics": {
          "default": [
            "activeUsers",
            "sessions"
          ],
          "description": "GA4 metrics, e.g. activeUsers, sessions, screenPageViews, conversions, engagementRate, totalRevenue",
          "items": {
            "type": "string"
          },
          "title": "Metrics",
          "type": "array"
        },
        "dimensions": {
          "default": [],
          "description": "GA4 dimensions, e.g. date, pagePath, sessionSource, sessionMedium, sessionDefaultChannelGroup, country, deviceCategory",
          "items": {
            "type": "string"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "date_ranges": {
          "default": [
            {
              "start_date": "28daysAgo",
              "end_date": "yesterday"
            }
          ],
          "description": "Date ranges to report on",
          "items": {
            "$ref": "#/$defs/DateRange"
          },
          "title": "Date Ranges",
          "type": "array"
        },
        "order_by_metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sort descending by this metric",
          "title": "Order By Metric"
        },
        "limit": {
          "default": 100,
          "description": "Maximum rows, up to 250000",
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Row offset for paging",
          "title": "Offset",
          "type": "integer"
        }
      },
      "required": [
        "property_id"
      ],
      "title": "RunReportInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AudioMeta": {
          "description": "Metadata for audio inputs/outputs.",
          "properties": {
            "type": {
              "default": "audio",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "seconds": {
