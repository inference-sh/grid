{
  "run": {
    "description": "",
    "input_schema": {
      "$defs": {
        "AspectRatioEnum": {
          "enum": [
            "adaptive",
            "21:9",
            "16:9",
            "4:3",
            "1:1",
            "3:4",
            "9:16"
          ],
          "title": "AspectRatioEnum",
          "type": "string"
        },
        "PromptExpansionEnum": {
          "enum": [
            "balanced",
            "quality"
          ],
          "title": "PromptExpansionEnum",
          "type": "string"
        },
        "ResolutionEnum": {
          "enum": [
            "480P",
            "768P"
          ],
          "title": "ResolutionEnum",
          "type": "string"
        }
      },
      "description": "MiniMax H3 Max \u2014 fal's post-trained H3.\n\nModes determined by inputs:\n- Text-to-video: prompt only (aspect_ratio required, no adaptive)\n- Image-to-video: prompt + image (optional end_image for first-last-frame)\n- Reference: prompt + reference images/videos/audio (aspect_ratio defaults to adaptive)",
      "properties": {
        "prompt": {
          "description": "Video prompt. Max 50000 chars. Use timeline markers like [0s-3s] for scene pacing.",
          "examples": [
            "A cinematic tracking shot through a misty forest at dawn, golden light filtering through ancient trees."
          ],
          "title": "Prompt",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "format": "file",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First frame image for image-to-video. Formats: JPG, PNG, WEBP, GIF, AVIF.",
          "title": "Image"
        },
        "end_image": {
          "anyOf": [
            {
              "format": "file",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last frame image. Requires image to be set as first frame.",
          "title": "End Image"
        },
        "reference_images": {
          "anyOf": [
            {
              "items": {
                "format": "file",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference images for style/subject guidance (max 9). Cannot combine with first/last frame.",
          "title": "Reference Images"
        },
        "reference_videos": {
          "anyOf": [
            {
              "items": {
                "format": "file",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference videos for motion/style (max 3). MP4, 2-15s each.",
          "title": "Reference Videos"
        },
        "reference_audios": {
          "anyOf": [
            {
              "items": {
                "format": "file",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference audio clips (max 3). Requires reference image or video. 2-15s each.",
          "title": "Reference Audios"
        },
        "duration": {
          "default": 5,
          "description": "Video duration in seconds (5-15).",
          "maximum": 15,
          "minimum": 5,
          "title": "Duration",
          "type": "integer"
        },
        "resolution": {
          "$ref": "#/$defs/ResolutionEnum",
          "default": "768P",
          "description": "Output resolution. 768P for best quality, 480P for faster/cheaper."
        },
        "aspect_ratio": {
          "$ref": "#/$defs/AspectRatioEnum",
          "default": "16:9",
          "description": "Aspect ratio. Text-to-video requires explicit value (not adaptive). Reference mode defaults to adaptive."
        },
        "prompt_expansion_mode": {
          "$ref": "#/$defs/PromptExpansionEnum",
          "default": "balanced",
          "description": "balanced (~1s) or quality (~30s extra) for richer prompt rewriting."
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Random seed for reproducible generation.",
          "title": "Seed"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "AppInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AudioMeta": {
          "description": "Metadata for audio inputs/outputs.",
          "properties": {
            "type": {
              "default": "audio",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "seconds": {
              "default": 0,
              "description": "Duration in seconds",
              "title": "Seconds",
              "type": "number"
            },
            "sample_rate": {
              "default": 0,
              "description": "Sample rate in Hz",
              "title": "Sample Rate",
              "type": "integer"
            }
          },
          "title": "AudioMeta",
          "type": "object"
        },
        "ImageMeta": {
          "description": "Metadata for image inputs/outputs.",
          "properties": {
            "type": {
              "default": "image",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "width": {
              "default": 0,
              "description": "Image width in pixels",
              "title": "Width",
              "type": "integer"
            },
            "height": {
              "default": 0,
              "description": "Image height in pixels",
              "title": "Height",
              "type": "integer"
            },
            "resolution_mp": {
              "default": 0,
              "description": "Resolution in megapixels (width * height / 1_000_000)",
              "title": "Resolution Mp",
              "type": "number"
            },
            "steps": {
              "default": 0,
              "description": "Number of diffusion steps",
              "title": "Steps",
              "type": "integer"
            },
            "count": {
              "default": 1,
              "description": "Number of images",
              "title": "Count",
              "type": "integer"
            }
          },
          "title": "ImageMeta",
          "type": "object"
        },
        "OutputMeta": {
          "description": "Structured metadata about task inputs and outputs for pricing calculation.\n\nApps include this in their output to report what was consumed (inputs)\nand what was produced (outputs). The backend uses this with CEL expressions\nto calculate app-level pricing.\n\nExample usage in an LLM app:\n    output_meta = OutputMeta(\n        inputs=[TextMeta(tokens=150)],\n        outputs=[TextMeta(tokens=500)]\n    )\n\nExample usage in a video generation app:\n    output_meta = OutputMeta(\n        outputs=[VideoMeta(\n            resolution=\"1080p\",\n            resolution_mp=2.07,\n            seconds=10.5,\n            fps=30\n        )]\n    )",
          "properties": {
            "inputs": {
              "description": "Metadata about consumed inputs",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TextMeta"
                  },
                  {
                    "$ref": "#/$defs/ImageMeta"
                  },
                  {
                    "$ref": "#/$defs/VideoMeta"
                  },
                  {
                    "$ref": "#/$defs/AudioMeta"
                  },
                  {
                    "$ref": "#/$defs/RawMeta"
                  }
                ]
              },
              "title": "Inputs",
              "type": "array"
            },
            "outputs": {
              "description": "Metadata about produced outputs",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TextMeta"
                  },
                  {
                    "$ref": "#/$defs/ImageMeta"
                  },
                  {
                    "$ref": "#/$defs/VideoMeta"
                  },
                  {
                    "$ref": "#/$defs/AudioMeta"
                  },
                  {
                    "$ref": "#/$defs/RawMeta"
                  }
                ]
              },
              "title": "Outputs",
              "type": "array"
            }
          },
          "title": "OutputMeta",
          "type": "object"
        },
        "RawMeta": {
          "description": "Metadata for raw inputs/outputs used for custom pricing.",
          "properties": {
            "type": {
              "default": "raw",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "cost": {
              "default": 0,
              "description": "Cost in dollar cents",
              "title": "Cost",
              "type": "number"
            }
          },
          "title": "RawMeta",
          "type": "object"
        },
        "TextMeta": {
          "description": "Metadata for text inputs/outputs (e.g., LLM tokens).",
          "properties": {
            "type": {
              "default": "text",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "tokens": {
              "default": 0,
              "description": "Token count - in inputs[] = input tokens, in outputs[] = output tokens",
              "title": "Tokens",
              "type": "integer"
            }
          },
          "title": "TextMeta",
          "type": "object"
        },
        "VideoMeta": {
          "description": "Metadata for video inputs/outputs.",
          "properties": {
            "type": {
              "default": "video",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "width": {
              "default": 0,
              "description": "Video width in pixels",
              "title": "Width",
              "type": "integer"
            },
            "height": {
              "default": 0,
              "description": "Video height in pixels",
              "title": "Height",
              "type": "integer"
            },
            "resolution_mp": {
              "default": 0,
              "description": "Resolution in megapixels per frame",
              "title": "Resolution Mp",
              "type": "number"
            },
            "resolution": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Standard resolution preset (480p, 720p, 1080p, 1440p, 4k)",
              "title": "Resolution"
            },
            "seconds": {
              "default": 0,
              "description": "Duration in seconds",
              "title": "Seconds",
              "type": "number"
            },
            "fps": {
              "default": 0,
              "description": "Frames per second",
              "title": "Fps",
              "type": "integer"
            }
          },
          "title": "VideoMeta",
          "type": "object"
        }
      },
      "properties": {
        "video": {
          "description": "The generated video file.",
          "format": "file",
          "title": "Video",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The seed used for generation.",
          "title": "Seed"
        },
        "expanded_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The prompt after expansion, as sent to the model.",
          "title": "Expanded Prompt"
        },
        "output_meta": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputMeta"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured metadata about inputs/outputs for pricing calculation"
        }
      },
      "required": [
        "video"
      ],
      "title": "AppOutput",
      "type": "object"
    }
  }
}