{
  "$defs": {
    "CameraKeyframe": {
      "properties": {
        "time": {
          "description": "Normalized video time, 0 at the start to 1 at the end.",
          "maximum": 1,
          "minimum": 0,
          "title": "Time",
          "type": "number"
        },
        "azimuth": {
          "description": "Horizontal camera angle around the subject, in degrees. Signed full turns are preserved.",
          "title": "Azimuth",
          "type": "number"
        },
        "elevation": {
          "description": "Vertical camera angle around the subject, in degrees.",
          "maximum": 90,
          "minimum": -90,
          "title": "Elevation",
          "type": "number"
        },
        "distance": {
          "description": "Camera distance from the subject in normalized scene units.",
          "minimum": 0,
          "title": "Distance",
          "type": "number"
        }
      },
      "required": [
        "time",
        "azimuth",
        "elevation",
        "distance"
      ],
      "title": "CameraKeyframe",
      "type": "object"
    },
    "PromptExpansionEnum": {
      "enum": [
        "disabled",
        "balanced",
        "quality"
      ],
      "title": "PromptExpansionEnum",
      "type": "string"
    },
    "ResolutionEnum": {
      "enum": [
        "480P",
        "768P",
        "1080P"
      ],
      "title": "ResolutionEnum",
      "type": "string"
    }
  },
  "properties": {
    "image": {
      "description": "Image to use as the first frame.",
      "format": "file",
      "title": "Image",
      "type": "string"
    },
    "camera_trajectory": {
      "description": "Ordered camera keyframes (max 12). The first pose is held before its time and the last pose for the remainder.",
      "examples": [
        [
          {
            "azimuth": 0,
            "distance": 1.0,
            "elevation": 10,
            "time": 0
          },
          {
            "azimuth": 90,
            "distance": 1.0,
            "elevation": 10,
            "time": 1
          }
        ]
      ],
      "items": {
        "$ref": "#/$defs/CameraKeyframe"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Camera Trajectory",
      "type": "array"
    },
    "prompt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional prompt. Defaults to preserving the frozen scene while only the camera moves.",
      "title": "Prompt"
    },
    "duration": {
      "default": 5,
      "description": "Video duration in seconds (1-15).",
      "maximum": 15,
      "minimum": 1,
      "title": "Duration",
      "type": "number"
    },
    "resolution": {
      "$ref": "#/$defs/ResolutionEnum",
      "default": "480P",
      "description": "480P native (default), 768P native, 1080P latent refinement."
    },
    "prompt_expansion_mode": {
      "$ref": "#/$defs/PromptExpansionEnum",
      "default": "balanced",
      "description": "Prompt rewriting effort."
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Random seed for reproducible generation.",
      "title": "Seed"
    }
  },
  "required": [
    "image",
    "camera_trajectory"
  ],
  "title": "AppInput",
  "type": "object"
}