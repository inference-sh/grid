{
  "run": {
    "description": "",
    "kind": "run",
    "capabilities": [],
    "input_schema": {
      "$defs": {
        "AspectRatioEnum": {
          "enum": [
            "auto",
            "21:9",
            "2:1",
            "16:9",
            "4:3",
            "1:1",
            "3:4",
            "9:16"
          ],
          "title": "AspectRatioEnum",
          "type": "string"
        },
        "Keyframe": {
          "properties": {
            "image": {
              "description": "Keyframe image (PNG, JPEG, or WebP).",
              "format": "file",
              "title": "Image",
              "type": "string"
            },
            "frame_index": {
              "description": "Frame position in the 24 fps output. Unique per keyframe and at most duration * 24.",
              "minimum": 0,
              "title": "Frame Index",
              "type": "integer"
            }
          },
          "required": [
            "image",
            "frame_index"
          ],
          "title": "Keyframe",
          "type": "object"
        },
        "ResolutionEnum": {
          "enum": [
            "720p",
            "1080p"
          ],
          "title": "ResolutionEnum",
          "type": "string"
        }
      },
      "description": "FLUX 3 Max video generation.\n\nMode is determined by the inputs:\n- Text-to-video: prompt only\n- Image-to-video: prompt + image (optional end_image as the last frame)\n- Keyframes-to-video: prompt + keyframes (cannot combine with image/end_image)",
      "properties": {
        "prompt": {
          "description": "Text prompt describing the video. For image modes, describe how the video unfolds from the image(s).",
          "examples": [
            "A cinematic tracking shot through a misty forest at dawn, golden light filtering through ancient trees."
          ],
          "title": "Prompt",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "format": "file",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First frame image for image-to-video (PNG, JPEG, or WebP).",
          "title": "Image"
        },
        "end_image": {
          "anyOf": [
            {
              "format": "file",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional last frame image (PNG, JPEG, or WebP). Requires image.",
          "title": "End Image"
        },
        "keyframes": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Keyframe"
              },
              "maxItems": 10,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Keyframe images pinned to frame positions (max 10, unique frame_index values). Cannot combine with image or end_image.",
          "title": "Keyframes"
        },
        "duration": {
          "default": 5,
          "description": "Video duration in seconds (5-20).",
          "maximum": 20,
          "minimum": 5,
          "title": "Duration",
          "type": "integer"
        },
        "resolution": {
          "$ref": "#/$defs/ResolutionEnum",
          "default": "720p",
          "description": "Output resolution. 720p is cheaper and faster; 1080p for best quality."
        },
        "aspect_ratio": {
          "$ref": "#/$defs/AspectRatioEnum",
          "default": "auto",
          "description": "Aspect ratio. auto uses 16:9 for text-to-video and follows the first image otherwise."
        },
        "generate_audio": {
          "default": true,
          "description": "Generate a native soundtrack for the video.",
          "title": "Generate Audio",
          "type": "boolean"
        },
        "reasoning_level": {
          "default": "high",
          "description": "How much effort to spend reasoning about the prompt. high is slower but follows the prompt more closely.",
          "enum": [
            "low",
            "high"
          ],
          "title": "Reasoning Level",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Random seed for reproducible generation.",
          "title": "Seed"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "AppInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AudioMeta": {
          "description": "Metadata for audio inputs/outputs.",
          "properties": {
            "type": {
              "default": "audio",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "seconds": {
              "default": 0,
              "description": "Duration in seconds",
              "title": "Seconds",
              "type": "number"
            },
            "sample_rate": {
              "default": 0,
              "description": "Sample rate in Hz",
              "title": "Sample Rate",
              "type": "integer"
            }
          },
          "title": "AudioMeta",
          "type": "object"
        },
        "ImageMeta": {
          "description": "Metadata for image inputs/outputs.",
          "properties": {
            "type": {
              "default": "image",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "width": {
              "default": 0,
              "description": "Image width in pixels",
              "title": "Width",
              "type": "integer"
            },
            "height": {
              "default": 0,
              "description": "Image height in pixels",
              "title": "Height",
              "type": "integer"
            },
            "resolution_mp": {
              "default": 0,
              "description": "Resolution in megapixels (width * height / 1_000_000)",
              "title": "Resolution Mp",
              "type": "number"
            },
            "steps": {
              "default": 0,
              "description": "Number of diffusion steps",
              "title": "Steps",
              "type": "integer"
            },
            "count": {
              "default": 1,
              "description": "Number of images",
              "title": "Count",
              "type": "integer"
            }
          },
          "title": "ImageMeta",
          "type": "object"
        },
        "OutputMeta": {
          "description": "Structured metadata about task inputs and outputs for pricing calculation.\n\nApps include this in their output to report what was consumed (inputs)\nand what was produced (outputs). The backend uses this with CEL expressions\nto calculate app-level pricing.\n\nExample usage in an LLM app (or OutputMeta.from_llm_usage(usage)):\n    output_meta = OutputMeta(\n        inputs=[TextMeta(tokens=150, cached_tokens=100)],\n        outputs=[TextMeta(tokens=500)]\n    )\n\nExample usage in a video generation app:\n    output_meta = OutputMeta(\n        outputs=[VideoMeta(\n            resolution=\"1080p\",\n            resolution_mp=2.07,\n            seconds=10.5,\n            fps=30\n        )]\n    )",
          "properties": {
            "inputs": {
              "description": "Metadata about consumed inputs",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TextMeta"
                  },
                  {
                    "$ref": "#/$defs/ImageMeta"
                  },
                  {
                    "$ref": "#/$defs/VideoMeta"
                  },
                  {
                    "$ref": "#/$defs/AudioMeta"
                  },
                  {
                    "$ref": "#/$defs/RawMeta"
                  }
                ]
              },
              "title": "Inputs",
              "type": "array"
            },
            "outputs": {
              "description": "Metadata about produced outputs",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TextMeta"
                  },
                  {
                    "$ref": "#/$defs/ImageMeta"
                  },
                  {
                    "$ref": "#/$defs/VideoMeta"
                  },
                  {
                    "$ref": "#/$defs/AudioMeta"
                  },
                  {
                    "$ref": "#/$defs/RawMeta"
                  }
                ]
              },
              "title": "Outputs",
              "type": "array"
            }
          },
          "title": "OutputMeta",
          "type": "object"
        },
        "RawMeta": {
          "description": "Metadata for raw inputs/outputs used for custom pricing.",
          "properties": {
            "type": {
              "default": "raw",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "cost": {
              "default": 0,
              "description": "Cost in dollar cents",
              "title": "Cost",
              "type": "number"
            }
          },
          "title": "RawMeta",
          "type": "object"
        },
        "TextMeta": {
          "description": "Metadata for text inputs/outputs (e.g., LLM tokens).",
          "properties": {
            "type": {
              "default": "text",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "tokens": {
              "default": 0,
              "description": "Token count - in inputs[] = input tokens (cached ones included), in outputs[] = output tokens",
              "title": "Tokens",
              "type": "integer"
            },
            "cached_tokens": {
              "default": 0,
              "description": "Input tokens read from the provider's prompt cache, part of tokens",
              "title": "Cached Tokens",
              "type": "integer"
            },
            "cache_write_tokens": {
              "default": 0,
              "description": "Input tokens written to the provider's prompt cache, part of tokens",
              "title": "Cache Write Tokens",
              "type": "integer"
            }
          },
          "title": "TextMeta",
          "type": "object"
        },
        "VideoMeta": {
          "description": "Metadata for video inputs/outputs.",
          "properties": {
            "type": {
              "default": "video",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "width": {
              "default": 0,
              "description": "Video width in pixels",
              "title": "Width",
              "type": "integer"
            },
            "height": {
              "default": 0,
              "description": "Video height in pixels",
              "title": "Height",
              "type": "integer"
            },
            "resolution_mp": {
              "default": 0,
              "description": "Resolution in megapixels per frame",
              "title": "Resolution Mp",
              "type": "number"
            },
            "resolution": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Standard resolution preset (480p, 720p, 1080p, 1440p, 4k)",
              "title": "Resolution"
            },
            "seconds": {
              "default": 0,
              "description": "Duration in seconds",
              "title": "Seconds",
              "type": "number"
            },
            "fps": {
              "default": 0,
              "description": "Frames per second",
              "title": "Fps",
              "type": "integer"
            }
          },
          "title": "VideoMeta",
          "type": "object"
        }
      },
      "properties": {
        "video": {
          "description": "The generated video file.",
          "format": "file",
          "title": "Video",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The seed used for generation.",
          "title": "Seed"
        },
        "output_meta": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputMeta"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured metadata about inputs/outputs for pricing calculation"
        }
      },
      "required": [
        "video"
      ],
      "title": "AppOutput",
      "type": "object"
    }
  }
}