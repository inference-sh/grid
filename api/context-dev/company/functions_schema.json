{
  "company_search": {
    "description": "Search companies",
    "kind": "run",
    "capabilities": [],
    "annotations": {
      "title": "Search companies",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    },
    "input_schema": {
      "$defs": {
        "CompanySearchFilters": {
          "additionalProperties": false,
          "properties": {
            "countries": {
              "anyOf": [
                {
                  "items": {
                    "$ref": "#/$defs/Country"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Headquarters countries as two-letter codes, such as US or GB.",
              "title": "Countries"
            },
            "employees_min": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Minimum headcount; includes overlapping employee ranges.",
              "title": "Employees Min"
            },
            "employees_max": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Maximum headcount; includes overlapping employee ranges.",
              "title": "Employees Max"
            }
          },
          "title": "CompanySearchFilters",
          "type": "object"
        },
        "Country": {
          "pattern": "^[A-Z]{2}$",
          "title": "Country",
          "type": "string"
        },
        "RequestTag": {
          "maxLength": 50,
          "minLength": 1,
          "title": "RequestTag",
          "type": "string"
        }
      },
      "properties": {
        "query": {
          "description": "Describe the companies to find.",
          "examples": [
            "Solar startups in California that raised a Series B"
          ],
          "maxLength": 500,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "filters": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompanySearchFilters"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cursor": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Use next_cursor with the same query and filters to fetch the next page.",
          "title": "Cursor"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RequestTag"
              },
              "maxItems": 20,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Labels for filtering usage in the dashboard.",
          "examples": [
            [
              "production",
              "team-alpha"
            ]
          ],
          "title": "Tags"
        }
      },
      "required": [
        "query"
      ],
      "title": "CompanySearchInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AudioMeta": {
          "description": "Metadata for audio inputs/outputs.",
          "properties": {
            "type": {
              "default": "audio",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "seconds": {
              "default": 0,
              "description": "Duration in seconds",
              "title": "Seconds",
              "type": "number"
            },
            "sample_rate": {
              "default": 0,
              "description": "Sample rate in Hz",
              "title": "Sample Rate",
              "type": "integer"
            }
          },
          "title": "AudioMeta",
          "type": "object"
        },
        "Employees": {
          "properties": {
            "count": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Employee count, when known.",
              "title": "Count"
            },
            "min": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Lower bound of the headcount range.",
              "title": "Min"
            },
            "max": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Upper headcount bound; null for open-ended ranges.",
              "title": "Max"
            }
          },
          "title": "Employees",
          "type": "object"
        },
        "Funding": {
          "properties": {
            "total_usd": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Total disclosed funding in US dollars.",
              "title": "Total Usd"
            },
            "round_count": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Number of known funding rounds.",
              "title": "Round Count"
            },
            "latest_round": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LatestRound"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The most recent known funding round; null when none is known."
            },
            "stage": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Current funding stage, when known.",
              "title": "Stage"
            },
            "rounds": {
              "anyOf": [
                {
                  "items": {
                    "$ref": "#/$defs/Round"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Known historical rounds; unavailable amounts are null.",
              "title": "Rounds"
            }
          },
          "title": "Funding",
          "type": "object"
        },
        "Headquarters": {
          "properties": {
            "country_code": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "ISO 3166-1 alpha-2 country code.",
              "title": "Country Code"
            },
            "region": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "State or region.",
              "title": "Region"
            },
            "city": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "City.",
              "title": "City"
            },
            "street_address": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Street address.",
              "title": "Street Address"
            },
            "postal_code": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Postal code.",
              "title": "Postal Code"
            }
          },
          "title": "Headquarters",
          "type": "object"
        },
        "ImageMeta": {
          "description": "Metadata for image inputs/outputs.",
          "properties": {
            "type": {
              "default": "image",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "width": {
              "default": 0,
              "description": "Image width in pixels",
              "title": "Width",
              "type": "integer"
            },
            "height": {
              "default": 0,
              "description": "Image height in pixels",
              "title": "Height",
              "type": "integer"
            },
            "resolution_mp": {
              "default": 0,
              "description": "Resolution in megapixels (width * height / 1_000_000)",
              "title": "Resolution Mp",
              "type": "number"
            },
            "steps": {
              "default": 0,
              "description": "Number of diffusion steps",
              "title": "Steps",
              "type": "integer"
            },
            "count": {
              "default": 1,
              "description": "Number of images",
              "title": "Count",
              "type": "integer"
            }
          },
          "title": "ImageMeta",
          "type": "object"
        },
        "KeyMetadata": {
          "properties": {
            "credits_consumed": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Credits charged for this request.",
              "title": "Credits Consumed"
            },
            "credits_remaining": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Credits remaining for your organization.",
              "title": "Credits Remaining"
            }
          },
          "title": "KeyMetadata",
          "type": "object"
        },
        "LatestRound": {
          "properties": {
            "type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Round type, such as seed or series_b.",
              "title": "Type"
            },
            "date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Announcement date (YYYY-MM-DD).",
              "title": "Date"
            },
            "amount_usd": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Round size in US dollars, when disclosed.",
              "title": "Amount Usd"
            }
          },
          "title": "LatestRound",
          "type": "object"
        },
        "OutputMeta": {
          "description": "Structured metadata about task inputs and outputs for pricing calculation.\n\nApps include this in their output to report what was consumed (inputs)\nand what was produced (outputs). The backend uses this with CEL expressions\nto calculate app-level pricing.\n\nExample usage in an LLM app (or OutputMeta.from_llm_usage(usage)):\n    output_meta = OutputMeta(\n        inputs=[TextMeta(tokens=150, cached_tokens=100)],\n        outputs=[TextMeta(tokens=500)]\n    )\n\nExample usage in a video generation app:\n    output_meta = OutputMeta(\n        outputs=[VideoMeta(\n            resolution=\"1080p\",\n            resolution_mp=2.07,\n            seconds=10.5,\n            fps=30\n        )]\n    )",
          "properties": {
            "inputs": {
              "description": "Metadata about consumed inputs",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TextMeta"
                  },
                  {
                    "$ref": "#/$defs/ImageMeta"
                  },
                  {
                    "$ref": "#/$defs/VideoMeta"
                  },
                  {
                    "$ref": "#/$defs/AudioMeta"
                  },
                  {
                    "$ref": "#/$defs/RawMeta"
                  }
                ]
              },
              "title": "Inputs",
              "type": "array"
            },
            "outputs": {
              "description": "Metadata about produced outputs",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TextMeta"
                  },
                  {
                    "$ref": "#/$defs/ImageMeta"
                  },
                  {
                    "$ref": "#/$defs/VideoMeta"
                  },
                  {
                    "$ref": "#/$defs/AudioMeta"
                  },
                  {
                    "$ref": "#/$defs/RawMeta"
                  }
                ]
              },
              "title": "Outputs",
              "type": "array"
            }
          },
          "title": "OutputMeta",
          "type": "object"
        },
        "RawMeta": {
          "description": "Metadata for raw inputs/outputs used for custom pricing.",
          "properties": {
            "type": {
              "default": "raw",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "cost": {
              "default": 0,
              "description": "Cost in dollar cents",
              "title": "Cost",
              "type": "number"
            }
          },
          "title": "RawMeta",
          "type": "object"
        },
        "Result": {
          "properties": {
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Company name.",
              "title": "Name"
            },
            "domain": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The company's website domain.",
              "title": "Domain"
            },
            "description": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "What the company does.",
              "title": "Description"
            },
            "organization_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Company type, such as public_company or privately_held.",
              "title": "Organization Type"
            },
            "operating_status": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Operating status, such as active, acquired or closed.",
              "title": "Operating Status"
            },
            "stock_symbols": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Known stock listings and ticker symbols.",
              "title": "Stock Symbols"
            },
            "revenue": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Revenue"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Estimated annual revenue in US dollars."
            },
            "industries": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Industries the company operates in.",
              "title": "Industries"
            },
            "founded_year": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Year the company was founded.",
              "title": "Founded Year"
            },
            "headquarters": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Headquarters"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Where the company is headquartered."
            },
            "employees": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Employees"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "How many people the company employs."
            },
            "funding": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Funding"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Known funding history."
            }
          },
          "title": "Result",
          "type": "object"
        },
        "Revenue": {
          "properties": {
            "min_usd": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Lower estimate of annual revenue in US dollars.",
              "title": "Min Usd"
            },
            "max_usd": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Upper estimate of annual revenue in US dollars.",
              "title": "Max Usd"
            }
          },
          "title": "Revenue",
          "type": "object"
        },
        "Round": {
          "properties": {
            "type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Round type, such as seed or series_b.",
              "title": "Type"
            },
            "date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Announcement date (YYYY-MM-DD).",
              "title": "Date"
            },
            "amount_usd": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Round size in US dollars, when disclosed.",
              "title": "Amount Usd"
            },
            "phase": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Initial financing or an extension, when known.",
              "title": "Phase"
            }
          },
          "title": "Round",
          "type": "object"
        },
        "TextMeta": {
          "description": "Metadata for text inputs/outputs (e.g., LLM tokens).",
          "properties": {
            "type": {
              "default": "text",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "tokens": {
              "default": 0,
              "description": "Token count - in inputs[] = input tokens (cached ones included), in outputs[] = output tokens",
              "title": "Tokens",
              "type": "integer"
            },
            "cached_tokens": {
              "default": 0,
              "description": "Input tokens read from the provider's prompt cache, part of tokens",
              "title": "Cached Tokens",
              "type": "integer"
            },
            "cache_write_tokens": {
              "default": 0,
              "description": "Input tokens written to the provider's prompt cache, part of tokens",
              "title": "Cache Write Tokens",
              "type": "integer"
            }
          },
          "title": "TextMeta",
          "type": "object"
        },
        "VideoMeta": {
          "description": "Metadata for video inputs/outputs.",
          "properties": {
            "type": {
              "default": "video",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "width": {
              "default": 0,
              "description": "Video width in pixels",
              "title": "Width",
              "type": "integer"
            },
            "height": {
              "default": 0,
              "description": "Video height in pixels",
              "title": "Height",
              "type": "integer"
            },
            "resolution_mp": {
              "default": 0,
              "description": "Resolution in megapixels per frame",
              "title": "Resolution Mp",
              "type": "number"
            },
            "resolution": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Standard resolution preset (480p, 720p, 1080p, 1440p, 4k)",
              "title": "Resolution"
            },
            "seconds": {
              "default": 0,
              "description": "Duration in seconds",
              "title": "Seconds",
              "type": "number"
            },
            "fps": {
              "default": 0,
              "description": "Frames per second",
              "title": "Fps",
              "type": "integer"
            }
          },
          "title": "VideoMeta",
          "type": "object"
        }
      },
      "properties": {
        "raw": {
          "default": null,
          "description": "The vendor's response, unchanged.",
          "title": "Raw"
        },
        "results": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Result"
              },
              "maxItems": 10,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Up to 10 matching companies, most relevant first by default.",
          "title": "Results"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pass as cursor to fetch the next page; null when there are no more results.",
          "title": "Next Cursor"
        },
        "key_metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unique ID of this request, also in `X-Request-Id`. Include it when contacting support.",
          "examples": [
            "3f1c2a6e-8b4d-4c1e-9f0a-2d7b5e6c8a91"
          ],
          "title": "Request Id"
        },
        "output_meta": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputMeta"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured metadata about inputs/outputs for pricing calculation"
        }
      },
      "title": "CompanySearchOutput",
      "type": "object"
    }
  }
}