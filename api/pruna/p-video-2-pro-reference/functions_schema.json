{
  "run": {
    "description": "",
    "kind": "run",
    "capabilities": [],
    "input_schema": {
      "$defs": {
        "AspectRatioEnum": {
          "enum": [
            "adaptive",
            "16:9",
            "9:16",
            "4:3",
            "3:4",
            "3:2",
            "2:3",
            "1:1"
          ],
          "title": "AspectRatioEnum",
          "type": "string"
        },
        "ModeEnum": {
          "enum": [
            "cost",
            "speed"
          ],
          "title": "ModeEnum",
          "type": "string"
        },
        "PromptUpsamplerEnum": {
          "enum": [
            "off",
            "turbo",
            "max"
          ],
          "title": "PromptUpsamplerEnum",
          "type": "string"
        },
        "ResolutionEnum": {
          "enum": [
            "480p",
            "768p",
            "1080p",
            "2k",
            "4k"
          ],
          "title": "ResolutionEnum",
          "type": "string"
        }
      },
      "properties": {
        "prompt": {
          "description": "Text description for video generation. Refer to references by what they show.",
          "title": "Prompt",
          "type": "string"
        },
        "images": {
          "description": "Reference images (up to 9 including first and last frames; 20 MiB, 4096 px each).",
          "items": {
            "format": "file",
            "type": "string"
          },
          "maxItems": 9,
          "title": "Images",
          "type": "array",
          "x-promoted": true
        },
        "videos": {
          "description": "Reference videos (up to 3; 2-15s each, 15s combined, up to 1080p/60 fps).",
          "items": {
            "format": "file",
            "type": "string"
          },
          "maxItems": 3,
          "title": "Videos",
          "type": "array",
          "x-promoted": true
        },
        "audios": {
          "description": "Reference audio (up to 3, 15s combined). Set keep_audio to use one file as the soundtrack.",
          "items": {
            "format": "file",
            "type": "string"
          },
          "maxItems": 3,
          "title": "Audios",
          "type": "array"
        },
        "keep_audio": {
          "default": false,
          "description": "Keep the single audio file as the video's audio. Needs exactly one audio file.",
          "title": "Keep Audio",
          "type": "boolean"
        },
        "first_frame_image": {
          "anyOf": [
            {
              "format": "file",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional opening image (soft keyframe, counts as a reference image).",
          "title": "First Frame Image"
        },
        "last_frame_image": {
          "anyOf": [
            {
              "format": "file",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional closing image (soft keyframe, counts as a reference image).",
          "title": "Last Frame Image"
        },
        "duration": {
          "default": 5,
          "description": "Video duration in seconds (5-15).",
          "maximum": 15,
          "minimum": 5,
          "title": "Duration",
          "type": "integer"
        },
        "resolution": {
          "$ref": "#/$defs/ResolutionEnum",
          "default": "768p",
          "description": "480p or 768p native. 1080p, 2k and 4k generate at 768p and upscale."
        },
        "mode": {
          "$ref": "#/$defs/ModeEnum",
          "default": "speed",
          "description": "speed (default) or cost (cheaper, slower)."
        },
        "prompt_upsampler": {
          "$ref": "#/$defs/PromptUpsamplerEnum",
          "default": "turbo",
          "description": "Rewrite the prompt before generation: turbo, max or off. Frame images force turbo."
        },
        "aspect_ratio": {
          "$ref": "#/$defs/AspectRatioEnum",
          "default": "16:9",
          "description": "Aspect ratio. adaptive follows the references."
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Random seed for reproducible generation.",
          "title": "Seed"
        },
        "enable_safety_filter": {
          "default": false,
          "description": "Check inputs against the content policy. Always-on categories are blocked either way.",
          "title": "Enable Safety Filter",
          "type": "boolean"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "AppInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AudioMeta": {
          "description": "Metadata for audio inputs/outputs.",
          "properties": {
            "type": {
              "default": "audio",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "seconds": {
              "default": 0,
              "description": "Duration in seconds",
              "title": "Seconds",
              "type": "number"
            },
            "sample_rate": {
              "default": 0,
              "description": "Sample rate in Hz",
              "title": "Sample Rate",
              "type": "integer"
            }
          },
          "title": "AudioMeta",
          "type": "object"
        },
        "ImageMeta": {
          "description": "Metadata for image inputs/outputs.",
          "properties": {
            "type": {
              "default": "image",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "width": {
              "default": 0,
              "description": "Image width in pixels",
              "title": "Width",
              "type": "integer"
            },
            "height": {
              "default": 0,
              "description": "Image height in pixels",
              "title": "Height",
              "type": "integer"
            },
            "resolution_mp": {
              "default": 0,
              "description": "Resolution in megapixels (width * height / 1_000_000)",
              "title": "Resolution Mp",
              "type": "number"
            },
            "steps": {
              "default": 0,
              "description": "Number of diffusion steps",
              "title": "Steps",
              "type": "integer"
            },
            "count": {
              "default": 1,
              "description": "Number of images",
              "title": "Count",
              "type": "integer"
            }
          },
          "title": "ImageMeta",
          "type": "object"
        },
        "OutputMeta": {
          "description": "Structured metadata about task inputs and outputs for pricing calculation.\n\nApps include this in their output to report what was consumed (inputs)\nand what was produced (outputs). The backend uses this with CEL expressions\nto calculate app-level pricing.\n\nExample usage in an LLM app (or OutputMeta.from_llm_usage(usage)):\n    output_meta = OutputMeta(\n        inputs=[TextMeta(tokens=150, cached_tokens=100)],\n        outputs=[TextMeta(tokens=500)]\n    )\n\nExample usage in a video generation app:\n    output_meta = OutputMeta(\n        outputs=[VideoMeta(\n            resolution=\"1080p\",\n            resolution_mp=2.07,\n            seconds=10.5,\n            fps=30\n        )]\n    )",
          "properties": {
            "inputs": {
              "description": "Metadata about consumed inputs",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TextMeta"
                  },
                  {
                    "$ref": "#/$defs/ImageMeta"
                  },
                  {
                    "$ref": "#/$defs/VideoMeta"
                  },
                  {
                    "$ref": "#/$defs/AudioMeta"
                  },
                  {
                    "$ref": "#/$defs/RawMeta"
                  }
                ]
              },
              "title": "Inputs",
              "type": "array"
            },
            "outputs": {
              "description": "Metadata about produced outputs",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TextMeta"
                  },
                  {
                    "$ref": "#/$defs/ImageMeta"
                  },
                  {
                    "$ref": "#/$defs/VideoMeta"
                  },
                  {
                    "$ref": "#/$defs/AudioMeta"
                  },
                  {
                    "$ref": "#/$defs/RawMeta"
                  }
                ]
              },
              "title": "Outputs",
              "type": "array"
            }
          },
          "title": "OutputMeta",
          "type": "object"
        },
        "RawMeta": {
          "description": "Metadata for raw inputs/outputs used for custom pricing.",
          "properties": {
            "type": {
              "default": "raw",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "cost": {
              "default": 0,
              "description": "Cost in dollar cents",
              "title": "Cost",
              "type": "number"
            }
          },
          "title": "RawMeta",
          "type": "object"
        },
        "TextMeta": {
          "description": "Metadata for text inputs/outputs (e.g., LLM tokens).",
          "properties": {
            "type": {
              "default": "text",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "tokens": {
              "default": 0,
              "description": "Token count - in inputs[] = input tokens (cached ones included), in outputs[] = output tokens",
              "title": "Tokens",
              "type": "integer"
            },
            "cached_tokens": {
              "default": 0,
              "description": "Input tokens read from the provider's prompt cache, part of tokens",
              "title": "Cached Tokens",
              "type": "integer"
            },
            "cache_write_tokens": {
              "default": 0,
              "description": "Input tokens written to the provider's prompt cache, part of tokens",
              "title": "Cache Write Tokens",
              "type": "integer"
            }
          },
          "title": "TextMeta",
          "type": "object"
        },
        "VideoMeta": {
          "description": "Metadata for video inputs/outputs.",
          "properties": {
            "type": {
              "default": "video",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "width": {
              "default": 0,
              "description": "Video width in pixels",
              "title": "Width",
              "type": "integer"
            },
            "height": {
              "default": 0,
              "description": "Video height in pixels",
              "title": "Height",
              "type": "integer"
            },
            "resolution_mp": {
              "default": 0,
              "description": "Resolution in megapixels per frame",
              "title": "Resolution Mp",
              "type": "number"
            },
            "resolution": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Standard resolution preset (480p, 720p, 1080p, 1440p, 4k)",
              "title": "Resolution"
            },
            "seconds": {
              "default": 0,
              "description": "Duration in seconds",
              "title": "Seconds",
              "type": "number"
            },
            "fps": {
              "default": 0,
              "description": "Frames per second",
              "title": "Fps",
              "type": "integer"
            }
          },
          "title": "VideoMeta",
          "type": "object"
        }
      },
      "properties": {
        "video": {
          "description": "Generated video with audio.",
          "format": "file",
          "title": "Video",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seed used for generation.",
          "title": "Seed"
        },
        "output_meta": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputMeta"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured metadata about inputs/outputs for pricing calculation"
        }
      },
      "required": [
        "video"
      ],
      "title": "AppOutput",
      "type": "object"
    }
  }
}