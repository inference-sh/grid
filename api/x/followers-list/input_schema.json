{
  "description": "Input schema for listing followers.",
  "properties": {
    "username": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Username to get followers for (without @)",
      "title": "Username"
    },
    "user_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "User ID to get followers for",
      "title": "User Id"
    },
    "max_results": {
      "default": 20,
      "description": "Maximum number of followers to return",
      "maximum": 100,
      "minimum": 1,
      "title": "Max Results",
      "type": "integer"
    }
  },
  "title": "AppInput",
  "type": "object"
}