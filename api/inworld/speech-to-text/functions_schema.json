          "default": null,
          "description": "BCP-47 language code (e.g. 'en-US', 'ja-JP'). Auto-detected if omitted.",
          "title": "Language"
        },
        "include_word_timestamps": {
          "default": false,
          "description": "Include per-word timing information in the output.",
          "title": "Include Word Timestamps",
