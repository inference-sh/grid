{
  "run": {
    "description": "",
    "kind": "run",
    "capabilities": [],
    "input_schema": {
      "description": "MiniMax H3 Image. Text-to-image from a prompt, or an edit when reference images are given.",
      "properties": {
        "prompt": {
          "description": "What to generate, or how to change the reference images. Refer to references as Picture 1, Picture 2, in upload order. Up to 32000 characters.",
          "examples": [
            "A ceramic teapot shaped like a lighthouse on a weathered wooden table, soft morning window light, shallow depth of field, product photography."
          ],
          "maxLength": 32000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Prompt",
          "type": "string"
        },
        "images": {
          "description": "Reference images for editing or composition, up to 16. JPG, PNG, WEBP, HEIC or HEIF; each side 128 to 8192 px; long side at most 4x the short side. Leave empty for text-to-image.",
          "items": {
            "format": "file",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Images",
          "type": "array"
        },
        "aspect_ratio": {
          "default": "auto",
          "description": "Output aspect ratio as X:Y (e.g. 16:9, 3:4, 21:9), between 1:3 and 3:1, or auto to let the model choose from the prompt and references.",
          "examples": [
            "16:9"
          ],
          "pattern": "^(auto|[1-9][0-9]{0,2}:[1-9][0-9]{0,2})$",
          "title": "Aspect Ratio",
          "type": "string"
        },
        "resolution": {
          "default": "2K",
          "description": "Output area: 1K (about 1024x1024), 2K (about 2048x2048) or 4K (about 4096x4096). Width and height follow the aspect ratio, e.g. 2K at 16:9 is 2720x1536.",
          "enum": [
            "1K",
            "2K",
            "4K"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "pattern": "^[1-9][0-9]{2,3}x[1-9][0-9]{2,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact output size as WIDTHxHEIGHT, e.g. 2720x1536. Overrides aspect_ratio and resolution. Area 655,360 to 20,000,000 px, ratio between 1:3 and 3:1.",
          "title": "Size"
        },
        "num_images": {
          "default": 1,
          "description": "Number of images to generate.",
          "maximum": 10,
          "minimum": 1,
          "title": "Num Images",
          "type": "integer"
        },
        "enhance_prompt": {
          "default": true,
          "description": "Let the model expand the prompt before generating. Always on when reference images are given. When off with aspect_ratio auto, the image is 1:1.",
          "title": "Enhance Prompt",
          "type": "boolean"
        },
        "output_format": {
          "default": "jpeg",
          "description": "Image file format.",
          "enum": [
            "jpeg",
            "png",
            "webp"
          ],
          "title": "Output Format",
          "type": "string"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "AppInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AudioMeta": {
          "description": "Metadata for audio inputs/outputs.",
          "properties": {
            "type": {
              "default": "audio",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "seconds": {
              "default": 0,
              "description": "Duration in seconds",
              "title": "Seconds",
              "type": "number"
            },
            "sample_rate": {
              "default": 0,
              "description": "Sample rate in Hz",
              "title": "Sample Rate",
              "type": "integer"
            }
          },
          "title": "AudioMeta",
          "type": "object"
        },
        "ImageMeta": {
          "description": "Metadata for image inputs/outputs.",
          "properties": {
            "type": {
              "default": "image",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "width": {
              "default": 0,
              "description": "Image width in pixels",
              "title": "Width",
              "type": "integer"
            },
            "height": {
              "default": 0,
              "description": "Image height in pixels",
              "title": "Height",
              "type": "integer"
            },
            "resolution_mp": {
              "default": 0,
              "description": "Resolution in megapixels (width * height / 1_000_000)",
              "title": "Resolution Mp",
              "type": "number"
            },
            "steps": {
              "default": 0,
              "description": "Number of diffusion steps",
              "title": "Steps",
              "type": "integer"
            },
            "count": {
              "default": 1,
              "description": "Number of images",
              "title": "Count",
              "type": "integer"
            }
          },
          "title": "ImageMeta",
          "type": "object"
        },
        "OutputMeta": {
          "description": "Structured metadata about task inputs and outputs for pricing calculation.\n\nApps include this in their output to report what was consumed (inputs)\nand what was produced (outputs). The backend uses this with CEL expressions\nto calculate app-level pricing.\n\nExample usage in an LLM app (or OutputMeta.from_llm_usage(usage)):\n    output_meta = OutputMeta(\n        inputs=[TextMeta(tokens=150, cached_tokens=100)],\n        outputs=[TextMeta(tokens=500)]\n    )\n\nExample usage in a video generation app:\n    output_meta = OutputMeta(\n        outputs=[VideoMeta(\n            resolution=\"1080p\",\n            resolution_mp=2.07,\n            seconds=10.5,\n            fps=30\n        )]\n    )",
          "properties": {
            "inputs": {
              "description": "Metadata about consumed inputs",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TextMeta"
                  },
                  {
                    "$ref": "#/$defs/ImageMeta"
                  },
                  {
                    "$ref": "#/$defs/VideoMeta"
                  },
                  {
                    "$ref": "#/$defs/AudioMeta"
                  },
                  {
                    "$ref": "#/$defs/RawMeta"
                  }
                ]
              },
              "title": "Inputs",
              "type": "array"
            },
            "outputs": {
              "description": "Metadata about produced outputs",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TextMeta"
                  },
                  {
                    "$ref": "#/$defs/ImageMeta"
                  },
                  {
                    "$ref": "#/$defs/VideoMeta"
                  },
                  {
                    "$ref": "#/$defs/AudioMeta"
                  },
                  {
                    "$ref": "#/$defs/RawMeta"
                  }
                ]
              },
              "title": "Outputs",
              "type": "array"
            }
          },
          "title": "OutputMeta",
          "type": "object"
        },
        "RawMeta": {
          "description": "Metadata for raw inputs/outputs used for custom pricing.",
          "properties": {
            "type": {
              "default": "raw",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "cost": {
              "default": 0,
              "description": "Cost in dollar cents",
              "title": "Cost",
              "type": "number"
            }
          },
          "title": "RawMeta",
          "type": "object"
        },
        "TextMeta": {
          "description": "Metadata for text inputs/outputs (e.g., LLM tokens).",
          "properties": {
            "type": {
              "default": "text",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "tokens": {
              "default": 0,
              "description": "Token count - in inputs[] = input tokens (cached ones included), in outputs[] = output tokens",
              "title": "Tokens",
              "type": "integer"
            },
            "cached_tokens": {
              "default": 0,
              "description": "Input tokens read from the provider's prompt cache, part of tokens",
              "title": "Cached Tokens",
              "type": "integer"
            },
            "cache_write_tokens": {
              "default": 0,
              "description": "Input tokens written to the provider's prompt cache, part of tokens",
              "title": "Cache Write Tokens",
              "type": "integer"
            }
          },
          "title": "TextMeta",
          "type": "object"
        },
        "VideoMeta": {
          "description": "Metadata for video inputs/outputs.",
          "properties": {
            "type": {
              "default": "video",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "width": {
              "default": 0,
              "description": "Video width in pixels",
              "title": "Width",
              "type": "integer"
            },
            "height": {
              "default": 0,
              "description": "Video height in pixels",
              "title": "Height",
              "type": "integer"
            },
            "resolution_mp": {
              "default": 0,
              "description": "Resolution in megapixels per frame",
              "title": "Resolution Mp",
              "type": "number"
            },
            "resolution": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Standard resolution preset (480p, 720p, 1080p, 1440p, 4k)",
              "title": "Resolution"
            },
            "seconds": {
              "default": 0,
              "description": "Duration in seconds",
              "title": "Seconds",
              "type": "number"
            },
            "fps": {
              "default": 0,
              "description": "Frames per second",
              "title": "Fps",
              "type": "integer"
            }
          },
          "title": "VideoMeta",
          "type": "object"
        }
      },
      "properties": {
        "images": {
          "description": "The generated images.",
          "items": {
            "format": "file",
            "type": "string"
          },
          "title": "Images",
          "type": "array"
        },
        "revised_prompts": {
          "description": "The prompt the model used for each image, after enhancement.",
          "items": {
            "type": "string"
          },
          "title": "Revised Prompts",
          "type": "array"
        },
        "output_meta": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputMeta"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured metadata about inputs/outputs for pricing calculation"
        }
      },
      "required": [
        "images"
      ],
      "title": "AppOutput",
      "type": "object"
    }
  }
}