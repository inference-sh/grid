  "post_message": {
    "description": "Post a message to a channel, or as a threaded reply.",
    "kind": "run",
    "capabilities": [],
    "input_schema": {
      "properties": {
        "channel": {
          "description": "Channel id (C0123456789) or name with or without the hash. Ids survive renames, so prefer them for anything long-lived; use list_channels to find one. The bot must be in the channel \u2014 invite it with /invite @yourbot, or posting fails with not_in_channel.",
          "examples": [
            "#alerts"
          ],
          "title": "Channel",
          "type": "string"
        },
        "text": {
          "description": "Message text, in Slack's mrkdwn: *bold*, _italic_, `code`, ```block```, <url|label>, <@U123> to mention. When blocks are given this becomes the notification fallback, so keep it meaningful rather than empty.",
          "examples": [
            "Deploy finished: api-v1048"
          ],
          "title": "Text",
          "type": "string"
        },
        "blocks": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Block Kit blocks for rich layout. Each item is one block object, e.g. {\"type\": \"section\", \"text\": {\"type\": \"mrkdwn\", \"text\": \"*hello*\"}}. Leave unset for a plain message.",
          "title": "Blocks"
        },
        "thread_ts": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reply inside a thread by passing the parent message's ts. Threading a findings feed keeps a channel readable: one message per incident, updates as replies.",
          "title": "Thread Ts"
        },
        "reply_broadcast": {
          "default": false,
          "description": "For a threaded reply, also show it in the channel. Use sparingly: it notifies everyone, which is the thing threading was avoiding.",
          "title": "Reply Broadcast",
          "type": "boolean"
        },
        "unfurl_links": {
          "default": true,
          "description": "Expand link previews. Turn off for noisy log links.",
          "title": "Unfurl Links",
          "type": "boolean"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override the bot's display name for this message. Needs chat:write.customize.",
          "title": "Username"
        },
        "icon_emoji": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override the bot's avatar with an emoji, e.g. :rotating_light:. Needs chat:write.customize.",
          "title": "Icon Emoji"
        }
      },
      "required": [
        "channel",
        "text"
      ],
      "title": "PostMessageInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AudioMeta": {
          "description": "Metadata for audio inputs/outputs.",
          "properties": {
            "type": {
              "default": "audio",
              "title": "Type",
              "type": "string"
            },
            "extra": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "App-specific key-value pairs for custom pricing factors",
              "title": "Extra"
            },
            "seconds": {
              "default": 0,
              "description": "Duration in seconds",
              "title": "Seconds",
              "type": "number"
            },
            "sample_rate": {
              "default": 0,
