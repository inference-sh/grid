        "limit": {
          "default": 100,
          "description": "Channels per page (1 to 1000).",
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "next_cursor from a previous call, to fetch the next page.",
          "title": "Cursor"
        },
        "exclude_archived": {
          "default": true,
          "description": "Skip archived channels.",
          "title": "Exclude Archived",
