{
  "$defs": {
    "FocusFixEnum": {
      "enum": [
        "none",
        "normal",
        "strong"
      ],
      "title": "FocusFixEnum",
      "type": "string"
    },
    "ModelEnum": {
      "enum": [
        "nyx",
        "nyx-high-fidelity",
        "nyx-xl",
        "nyx-fast"
      ],
      "title": "ModelEnum",
      "type": "string"
    },
    "VideoTypeEnum": {
      "enum": [
        "progressive",
        "interlaced",
        "progressive-interlaced"
      ],
      "title": "VideoTypeEnum",
      "type": "string"
    }
  },
  "properties": {
    "video": {
      "description": "input video file",
      "format": "file",
      "title": "Video",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/ModelEnum",
      "default": "nyx",
      "description": "denoise model: nyx (balanced), nyx-high-fidelity (detail preservation), nyx-xl (heavy noise), nyx-fast (speed optimized)"
    },
    "video_type": {
      "$ref": "#/$defs/VideoTypeEnum",
      "default": "progressive",
      "description": "source video type"
    },
    "focus_fix": {
      "$ref": "#/$defs/FocusFixEnum",
      "default": "none",
      "description": "focus fix level"
    },
    "compression": {
      "default": 0.0,
      "description": "compression artifact reduction (-1 to 1)",
      "maximum": 1.0,
      "minimum": -1.0,
      "title": "Compression",
      "type": "number"
    },
    "details": {
      "default": 0.0,
      "description": "detail enhancement (-1 to 1)",
      "maximum": 1.0,
      "minimum": -1.0,
      "title": "Details",
      "type": "number"
    },
    "noise": {
      "default": 0.0,
      "description": "noise reduction (-1 to 1)",
      "maximum": 1.0,
      "minimum": -1.0,
      "title": "Noise",
      "type": "number"
    },
    "halo": {
      "default": 0.0,
      "description": "halo reduction (-1 to 1)",
      "maximum": 1.0,
      "minimum": -1.0,
      "title": "Halo",
      "type": "number"
    },
    "blur": {
      "default": 0.0,
      "description": "blur reduction (-1 to 1)",
      "maximum": 1.0,
      "minimum": -1.0,
      "title": "Blur",
      "type": "number"
    },
    "grain": {
      "default": 0.0,
      "description": "grain amount (0-0.1)",
      "maximum": 0.1,
      "minimum": 0.0,
      "title": "Grain",
      "type": "number"
    },
    "recover_original_detail": {
      "default": 0.0,
      "description": "recover original detail (0-1)",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Recover Original Detail",
      "type": "number"
    }
  },
  "required": [
    "video"
  ],
  "title": "AppInput",
  "type": "object"
}