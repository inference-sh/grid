{
  "$defs": {
    "RatioEnum": {
      "enum": [
        "1280:720",
        "720:1280",
        "720:720",
        "960:720",
        "720:960",
        "1680:720",
        "1920:1080",
        "1080:1920",
        "1024:1024",
        "1080:1080",
        "1168:880",
        "1360:768",
        "1440:1080",
        "1080:1440",
        "1808:768",
        "2112:912"
      ],
      "title": "RatioEnum",
      "type": "string"
    },
    "ReferenceImage": {
      "properties": {
        "image": {
          "description": "Reference image.",
          "format": "file",
          "title": "Image",
          "type": "string"
        },
        "tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tag name to reference in prompt with @tagName syntax.",
          "title": "Tag"
        }
      },
      "required": [
        "image"
      ],
      "title": "ReferenceImage",
      "type": "object"
    }
  },
  "properties": {
    "prompt": {
      "description": "Text prompt. Use @tagName to reference tagged images.",
      "title": "Prompt",
      "type": "string"
    },
    "ratio": {
      "$ref": "#/$defs/RatioEnum",
      "default": "1280:720",
      "description": "Output image aspect ratio. 720p = 5 credits, 1080p = 8 credits."
    },
    "reference_images": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ReferenceImage"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reference images with optional tags for style/subject guidance.",
      "title": "Reference Images"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Seed for reproducible results.",
      "title": "Seed"
    }
  },
  "required": [
    "prompt"
  ],
  "title": "AppInput",
  "type": "object"
}