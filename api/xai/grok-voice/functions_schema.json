            },
            "fps": {
              "default": 0,
              "description": "Frames per second",
              "title": "Fps",
              "type": "integer"
            }
          },
          "title": "VideoMeta",
          "type": "object"
        },
        "Voice": {
          "properties": {
            "id": {
              "description": "What to pass as voice or custom_voice",
              "title": "Id",
              "type": "string"
            },
            "name": {
              "default": "",
              "description": "Display name",
              "title": "Name",
              "type": "string"
            },
            "description": {
              "default": "",
              "description": "Tone and character, as xAI describes it",
              "title": "Description",
              "type": "string"
            },
            "custom": {
              "default": false,
              "description": "A voice cloned by this account",
              "title": "Custom",
