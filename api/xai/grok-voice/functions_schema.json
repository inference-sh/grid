            }
          },
          "required": [
            "id"
          ],
          "title": "Voice",
          "type": "object"
        }
      },
      "properties": {
        "voices": {
          "description": "Built-in voices, then this account's custom voices",
          "items": {
            "$ref": "#/$defs/Voice"
          },
          "title": "Voices",
          "type": "array"
        },
        "output_meta": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputMeta"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured metadata about inputs/outputs for pricing calculation"
        }
      },
      "required": [
        "voices"
      ],
      "title": "VoicesOutput",
      "type": "object"
    }
  }
}