#!/usr/bin/env python3
"""Test stand-in for `belt harness serve` (the protocol in claude_code_helper).

Per request: a "usage" request answers a plan at 12.5% of its 5-hour window,
or, for the token "bad", windows that could not be read; the token "bad"
answers code "auth"; input text "TOOL" streams a
tool call; "SLOW" streams a delta every 50ms until a {"id", "cancel": true}
line (then nothing more); anything else streams the text back in two deltas. Every line read
is appended to $FAKE_BELT_LOG (token replaced) when set.
"""
import json, os, sys, threading, time

if sys.argv[1:3] != ["harness", "serve"]:
    sys.exit(f"fake-belt: unsupported {sys.argv[1:]}")
log = os.environ.get("FAKE_BELT_LOG")
leaked = [k for k in ("CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL") if k in os.environ]
print(f"fake serve up; claude={os.environ.get('CLAUDE_BIN')} leaked_env={leaked}", file=sys.stderr, flush=True)


lock = threading.Lock()
cancelled = set()


def out(o):
    with lock:
        sys.stdout.write(json.dumps(o) + "\n")
        sys.stdout.flush()


def slow(rid):
    for i in range(200):
        if rid in cancelled:
            return
        out({"id": rid, "delta": {"response": f"chunk{i} "}})
        time.sleep(0.05)
    out({"id": rid, "output": {"response": "never cancelled"}})


for line in sys.stdin:
    req = json.loads(line)
    if log:
        with open(log, "a") as f:
            f.write(json.dumps({**req, "token": "[redacted]", "leaked_env": leaked}) + "\n")
    if req.get("cancel"):
        cancelled.add(req["id"])
        continue
    rid, tok = req["id"], req["token"]
    if req.get("usage"):
        if tok == "bad":
            out({"id": rid, "usage": {"account": {"status": "authenticated", "type": "subscription"},
                                      "limits": {"checked_at": "2026-10-25T10:00:00Z", "windows": [],
                                                 "unavailable": {"reason": "probe_failed", "message": "claude: oauth usage: 401 Unauthorized"}}}})
        else:
            out({"id": rid, "usage": {"account": {"status": "authenticated", "type": "subscription"},
                                      "limits": {"checked_at": "2026-10-25T10:00:00Z", "windows": [
                                          {"id": "five_hour", "kind": "session", "label": "5-hour", "used_percent": 12.5,
                                           "resets_at": "2026-10-25T15:00:00Z", "duration_minutes": 300}]}}})
        continue
    inp = req["input"]
    usage = {"stop_reason": "stop", "prompt_tokens": 12, "completion_tokens": 5, "total_tokens": 17}
    if tok == "bad":
        out({"id": rid, "error": "Claude rejected the credential; reconnect Claude Code (credentials → Claude Code)", "code": "auth"})
    elif inp.get("text") == "SLOW":
        threading.Thread(target=slow, args=(rid,), daemon=True).start()
    elif inp.get("text") == "TOOL":
        args = '{"query": "weather in Paris"}'
        out({"id": rid, "delta": {"tool_calls": [{"index": 0, "id": "toolu_1", "type": "function", "function": {"name": "search"}}]}})
        out({"id": rid, "delta": {"tool_calls": [{"index": 0, "function": {"arguments": args}}]}})
        out({"id": rid, "output": {"response": "", "tool_calls": [{"id": "toolu_1", "type": "function", "function": {"name": "search", "arguments": args}}], "usage": {**usage, "stop_reason": "tool_calls"}}})
    else:
        text = f"[{req['model']}] {inp.get('text', '')}"
        half = len(text) // 2
        out({"id": rid, "delta": {"response": text[:half]}})
        out({"id": rid, "delta": {"response": text[half:]}})
        out({"id": rid, "output": {"response": text, "usage": usage}})
