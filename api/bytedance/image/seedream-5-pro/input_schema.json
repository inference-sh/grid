{
  "$defs": {
    "AspectRatioEnum": {
      "description": "Aspect ratio options.",
      "enum": [
        "1:1",
        "3:4",
        "4:3",
        "16:9",
        "9:16",
        "3:2",
        "2:3",
        "21:9"
      ],
      "title": "AspectRatioEnum",
      "type": "string"
    },
    "OutputFormatEnum": {
      "description": "Output image format.",
      "enum": [
        "png",
        "jpeg"
      ],
      "title": "OutputFormatEnum",
      "type": "string"
    },
    "SizeEnum": {
      "description": "Image size/resolution options.",
      "enum": [
        "1K",
        "2K"
      ],
      "title": "SizeEnum",
      "type": "string"
    }
  },
  "description": "Input schema for Seedream 5.0 Pro image generation.",
  "properties": {
    "prompt": {
      "description": "Text prompt describing the image to generate or the edit to perform. Supports complex instructions: infographics, precise regional edits, layer-aware design, and text rendering in 14 languages.",
      "examples": [
        "A detailed infographic explaining the water cycle, clean editorial design, labeled arrows, soft color palette"
      ],
      "title": "Prompt",
      "type": "string"
    },
    "images": {
      "anyOf": [
        {
          "items": {
            "format": "file",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional reference images for image editing or multi-reference generation. Up to 10 images supported.",
      "title": "Images"
    },
    "size": {
      "$ref": "#/$defs/SizeEnum",
      "default": "2K",
      "description": "Output image resolution. 1K or 2K."
    },
    "aspect_ratio": {
      "$ref": "#/$defs/AspectRatioEnum",
      "default": "1:1",
      "description": "Output image aspect ratio."
    },
    "output_format": {
      "$ref": "#/$defs/OutputFormatEnum",
      "default": "png",
      "description": "Output image format (png or jpeg)."
    },
    "watermark": {
      "default": false,
      "description": "Whether to add a watermark to the generated image.",
      "title": "Watermark",
      "type": "boolean"
    }
  },
  "required": [
    "prompt"
  ],
  "title": "AppInput",
  "type": "object"
}