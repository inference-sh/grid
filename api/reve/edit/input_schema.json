{
  "properties": {
    "image": {
      "description": "Reference image to edit.",
      "format": "file",
      "title": "Image",
      "type": "string"
    },
    "edit_instruction": {
      "description": "Natural language instruction for the edit (e.g. 'Remove all people in the background').",
      "maxLength": 2560,
      "title": "Edit Instruction",
      "type": "string"
    },
    "aspect_ratio": {
      "anyOf": [
        {
          "enum": [
            "16:9",
            "9:16",
            "3:2",
            "2:3",
            "4:3",
            "3:4",
            "1:1"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Output aspect ratio. If not set, uses the reference image's ratio.",
      "title": "Aspect Ratio"
    },
    "version": {
      "default": "latest",
      "description": "Model version (e.g. 'latest' or 'reve-edit@20250915').",
      "title": "Version",
      "type": "string"
    },
    "test_time_scaling": {
      "anyOf": [
        {
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Spend more time for better quality (1-5). Values above 1 cost additional credits.",
      "title": "Test Time Scaling"
    },
    "upscale_factor": {
      "anyOf": [
        {
          "maximum": 4,
          "minimum": 2,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Upscale output by 2x, 3x, or 4x.",
      "title": "Upscale Factor"
    },
    "remove_background": {
      "default": false,
      "description": "Make background transparent.",
      "title": "Remove Background",
      "type": "boolean"
    }
  },
  "required": [
    "image",
    "edit_instruction"
  ],
  "title": "AppInput",
  "type": "object"
}